{
  "名称": "L7可交易过滤池规则",
  "版本": "2026-05-01",
  "定位": "优先读取L8X综合候选池，缺失时回退L8指数基底池，剔除ST、停牌、低成交额、低价和数据不足股票，生成L7可交易过滤池。",
  "输入": {
    "候选池": "03数据/130X综合候选池/L8X综合候选池_最新.json",
    "备用候选池": "03数据/130指数基底池/L8指数基底池_最新.json"
  },
  "输出": {
    "数据目录": "03数据/132可交易过滤池",
    "最新文件": "L7可交易过滤池_最新.json"
  },
  "过滤规则": {
    "剔除ST": true,
    "剔除当日停牌": true,
    "剔除连续停牌大于天数": 5,
    "最低日均成交额_万元": 3000,
    "成交额计算周期": 20,
    "最低有效交易日": 15,
    "最低收盘价": 1.0,
    "剔除涨跌停": false,
    "主板涨跌停阈值": 9.9,
    "创业板科创板涨跌停阈值": 19.9,
    "北交所涨跌停阈值": 29.9
  },
  "数据源": {
    "历史K线": "腾讯公开复权日线接口；东方财富公开历史K线接口",
    "主数据源": "tencent",
    "获取自然日回看天数": 60,
    "并发线程数": 4,
    "请求超时秒": 25,
    "失败重试次数": 3
  },
  "安全边界": {
    "是否自动交易": false,
    "是否调用券商接口": false,
    "是否触发n8n": false,
    "是否企业微信真实发送": false,
    "是否写旧系统": false,
    "是否写正式库": false
  }
}
