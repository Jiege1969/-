{
    "规则名称":  "清债决策引擎规则",
    "版本":  "2026-05-06",
    "状态":  "当前执行",
    "定位":  "把摸清家底找差距清债施工经验转化为机器可执行的目录旧债判定规则。",
    "核心原则":  [
                 "清债不是留档、观察、以后处理的堆叠游戏。",
                 "能由扫描证实无当前依赖的旧项，应当收口，不推回用户确认。",
                 "保留最新资产、母样本、审计证据、防复发规则和可执行脚本，不保留坏状态本身。",
                 "股票系统是母样本，只复制成功结构、验收方法和安全边界，不复制探索期旧债。"
             ],
    "分类规则":  [
                 {
                     "分类":  "可收口旧流水",
                     "判定":  "文件名含时间戳，目录内存在同类最新锚点，路径不命中审计关键词，且未发现现役依赖必须读取历史文件。",
                     "处理":  "补齐必要最新锚点后删除时间戳副本；源头改为最新覆盖。",
                     "输出口径":  "action_close"
                 },
                 {
                     "分类":  "需补锚点再收口",
                     "判定":  "文件名含时间戳，目录内没有最新锚点，内容属于可再生报告、验收、探针或流水。",
                     "处理":  "先把最新一份复制或生成到标准最新文件，修脚本源头，再删除旧时间戳副本。",
                     "输出口径":  "action_anchor_then_close"
                 },
                 {
                     "分类":  "审计资产单独核实",
                     "判定":  "路径或文件名命中人工、回执、正式导入、真实发送、凭据、审计、写入前备份、历史K线刷新前备份、不可再生等关键词。",
                     "处理":  "不得混入普通流水批量删除；先判定不可再生/可回滚/正式证据，再按审计资产规则保留最新正式证据和必要回滚包。",
                     "输出口径":  "action_audit_review"
                 },
                 {
                     "分类":  "现役保留",
                     "判定":  "文件是最新锚点、母样本、规则、台账、当前报告、当前配置或运行入口依赖。",
                     "处理":  "保留；如存在重复路径，合并到当前权威资产。",
                     "输出口径":  "action_keep"
                 }
             ],
