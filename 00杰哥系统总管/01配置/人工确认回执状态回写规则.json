  "允许决策": [
    "同意进入许可令草案",
    "拒绝执行",
    "延后处理",
    "要求补充材料"
  ],
  "状态建议映射": {
    "同意进入许可令草案": "待人工确认",
    "拒绝执行": "禁止执行",
    "延后处理": "待处理",
    "要求补充材料": "失败待诊断"
  },
  "强制阻断类型": [
    "税收业务",
    "旧系统写入",
    "删除",
    "覆盖",
    "重启服务",
    "真实发送",
    "正式库写入"
  ],
  "验收标准": [
    "能够读取人工确认单",
    "能够生成回执草案",
    "回执草案不改变任何任务状态",
    "回执草案不签发许可令",
    "回执草案不触发执行器",
    "回执草案不触发n8n",
