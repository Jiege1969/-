  "阶段": "人工确认回执状态回写草案",
  "默认开关": {
    "允许自动回写任务状态": false,
    "允许自动签发许可令": false,
    "允许触发执行器": false,
    "允许触发n8n": false,
    "允许真实发送": false,
    "允许写正式库": false,
    "允许旧系统写入": false
