{
  "名称": "各业务输出质量周报规则",
  "版本": "v1.0",
  "生成时间": "2026-05-09",
  "定位": "让进化系统每周从总管接续包、业务日志和反馈材料中产出可视化体检报告，帮助总管判断哪个子系统输出质量最需要改进。",
  "建议周期": {
    "频率": "每周一次",
    "建议时间": "周二 08:30",
    "原因": "避开盘前股票高峰前的深夜计算窗口，周二早上可查看上一周输出质量。"
  },
  "默认统计窗口": {
    "开始": "上周一 00:00",
    "结束": "上周日 23:59"
  },
  "统计对象": [
    "总管系统",
    "企业微信公共接入层",
    "股票研究系统",
    "税收业务系统",
    "视频制作系统",
    "本职工作系统",
    "内容处理系统",
    "知识库系统",
    "进化系统"
  ],
  "输出字段": [
    "子系统",
    "触发次数",
    "用户正向反馈次数",
    "用户纠正/负向反馈次数",
    "主要负向反馈摘录",
    "本周建议"
  ],
  "反馈识别口径": {
    "正向关键词": [
      "通过",
      "可以",
      "收到",
      "谢谢",
      "好多了",
      "正确",
      "符合"
    ],
    "负向关键词": [
      "不对",
      "不符合",
      "缺点",
      "太空泛",
      "风险没讲清",
      "没讲清",
      "没有完整",
      "误判",
      "旧债",
      "凭空",
      "不要新建包"
    ],
    "说明": "第一版只做文本线索统计，不把验收pass等同于用户正向反馈；后续可接企业微信真实反馈账本。"
  },
  "输出要求": [
    "只读统计，不修改业务系统正式规则。",
    "负向摘录只保留短句，不输出隐私材料全文。",
    "报告末尾必须给出一个本周最该优先改进的子系统建议。",
    "如数据不足，必须明确写数据不足，不得编造触发次数或反馈次数。"
  ],
  "安全边界": {
    "是否触发n8n": false,
    "是否真实发送企业微信": false,
    "是否写正式规则": false,
    "是否重载服务": false
  }
}
