{
  "规则名称": "数据资产双副本规则",
  "版本": "2026-05-06",
  "状态": "建议十已固化",
  "定位": "区分不可再生数据、可再生数据和中间产物；不可再生数据必须至少具备 D 盘与 F 盘两份副本。",
  "数据分类": {
    "不可再生数据": [
      "用户手写文档",
      "规则沉淀",
      "人工标注",
      "复盘记录",
      "分析手稿",
      "许可回执",
      "验收证据"
    ],
    "可再生数据": [
      "可重新下载的模型权重",
      "可重新拉取的行情数据",
      "可重新生成的依赖缓存"
    ],
    "中间产物": [
      "模型推理缓存",
      "临时渲染文件",
      "临时调试输出",
      "可重新生成的报告草稿"
    ]
  },
  "强制规则": [
    "不可再生数据必须至少有 D 盘与 F 盘两份副本",
    "可再生数据必须记录来源和重建方法",
    "中间产物必须有保留期或清理口径",
    "每周骨架探针应检查不可再生数据清单的两份副本是否存在"
  ],
  "安全边界": {
    "本规则创建不移动数据": true,
    "本规则创建不删除数据": true,
    "本规则创建不触发n8n": true,
    "本规则创建不发送企业微信": true
  }
}
