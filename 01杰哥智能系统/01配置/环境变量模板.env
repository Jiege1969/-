# ============================================================
# Name: env-template.env
# Purpose: Environment variable template for the v3 core service stack.
# Trigger: Copied to an approved runtime env file before deployment.
# Owner system: 01 core system.
# Dependencies: Docker Compose draft or future implementation compose file.
# Safety: Template only. It contains no real secrets and must not be used
#         as a production secret file.
# Change log: 2026-04-26 created env template.
# ============================================================

# PostgreSQL
POSTGRES_DB=jiege_v3
POSTGRES_USER=jiege_v3
POSTGRES_PASSWORD=PLEASE_SET_STRONG_PASSWORD

# Agent
DEFAULT_CHAT_MODEL=qwen3:14b
DEFAULT_DEEP_MODEL=qwen3:30b
DEFAULT_REASONING_MODEL=deepseek-r1:32b
DEFAULT_CODE_MODEL=qwen3-coder:30b
DEFAULT_VISION_MODEL=gemma3:27b
OLLAMA_URL=http://127.0.0.1:29134
REDIS_URL=redis://127.0.0.1:26379/0

# Message gateway
WECOM_WEBHOOK_URL=PLEASE_SET_WECOM_WEBHOOK_URL
WECOM_SECRET=PLEASE_SET_WECOM_SECRET

# Safety
ENABLE_DANGEROUS_ACTIONS=false
ENABLE_AUTO_REPAIR=false
ENABLE_MODEL_AUTO_SWITCH=false
