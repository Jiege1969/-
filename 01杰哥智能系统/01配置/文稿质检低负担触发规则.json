{
  "名称": "文稿质检低负担触发规则",
  "版本": "2026-05-03",
  "定位": "控制文稿质检和写作模型审稿何时触发，防止报告润色能力增加日常运行负担。",
  "总原则": [
    "正式链路默认不调用大模型审稿。",
    "规则检查优先，模型审稿按需触发。",
    "企业微信问答、股票查询、系统状态检查优先保持快速响应。",
    "写作模型只能做审稿建议，不生成股票判断，不修改事实字段。",
    "多模型同稿对比只做少量样本试验，不进入日常链路。"
  ],
  "默认策略": {
    "正式推送前自动模型审稿": false,
    "普通对话模型审稿": false,
    "普通股票查询模型审稿": false,
    "默认动作": "no_review",
    "默认说明": "不增加正式链路耗时；只使用既有报告模板和脚本硬检查。"
  },
  "触发类型": {
    "manual_review": {
      "触发词": ["#审稿", "审稿"],
      "动作": "light_model_review",
      "默认模型": "qwen2.5:7b",
      "说明": "用户明确要求审稿时，调用轻量主编模型。"
    },
    "manual_deep_review": {
      "触发词": ["#深度审稿", "深度审稿"],
      "动作": "enhanced_model_review_candidate",
      "候选模型": ["glm4:latest", "qwen3:14b", "gemma3:27b"],
      "说明": "只作为增强主编候选，不常驻，不自动替换。"
    },
    "low_peak_batch": {
      "动作": "light_model_review",
      "允许时间窗": [
        {"开始": "22:30", "结束": "06:30"}
      ],
      "每日样本上限": 5,
      "说明": "低峰抽样审稿，不影响白天企业微信使用。"
    },
    "important_report": {
      "适用文稿": ["stock_daily_recommendation", "stock_single_report", "stock_position_diagnosis"],
      "动作": "rule_first_optional_light_model",
      "说明": "重点报告先跑规则检查，只有手动或低峰条件满足时才调用模型。"
    },
    "model_compare": {
      "动作": "plan_only_or_manual_sample",
      "样本总量": "5-10份",
      "每日样本上限": 2,
      "候选模型": ["qwen2.5:7b", "glm4:latest", "qwen3:14b", "gemma3:27b"],
      "说明": "候选写作模型只做同稿对比试验，不进入正式链路。"
    }
  },
  "硬性禁止": {
    "自动替换正式原文": false,
    "自动发送企业微信": false,
    "自动改变股票结论": false,
    "自动改变推荐名单": false,
    "自动修改价格线和风险线": false,
    "高峰期常态调用增强模型": false
  },
  "硬件保护": {
    "核心服务优先": ["19300股票助手", "19302企业微信桥接", "n8n", "Redis", "Ollama基础服务"],
    "增强模型默认常驻": false,
    "模型不可用时处理": "跳过模型审稿，记录原因，不阻断正式链路",
    "响应超时时处理": "审稿失败但正式链路继续"
  },
  "胜出标准": {
    "禁止字段改动数": 0,
    "必备栏目齐全": true,
    "技术指标直出": 0,
    "手机长行数量": "下降或为0",
    "用户答案清晰度": "能回答看不看、怎么看、错了怎么办",
    "审稿耗时": "不影响日常使用"
  }
}
