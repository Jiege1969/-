"""
名称：服务入口.py
作用：提供 v3 第一阶段智能体大脑测试接口，包含健康检查、任务识别、模型选择和轻量思考。
触发方式：python -m uvicorn 服务入口:app --host 127.0.0.1 --port 28100
依赖：fastapi、uvicorn
所属系统：01杰哥智能系统
创建/修改记录：2026-04-26 创建第一阶段最小可运行版本。
"""

from __future__ import annotations

from datetime import datetime
import json
from typing import Any

from fastapi import FastAPI
from fastapi import Response

from Ollama客户端 import 生成文本, 读取模型列表
from 能力注册 import 规划能力调用, 能力列表
from 任务识别 import 识别任务
from 模型路由器 import 选择模型
