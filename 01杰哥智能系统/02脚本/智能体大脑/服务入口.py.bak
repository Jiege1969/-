from 税收业务接口 import 税收业务状态, 读取税收业务处理计划, 读取税收政策案例索引, 读取税种分类索引


app = FastAPI(title="杰哥智能化系统 v3 智能体大脑", version="3.0.0-alpha1")


def 当前时间() -> str:
    return datetime.now().strftime("%Y-%m-%d %H:%M:%S")


@app.get("/健康")
def 健康检查() -> dict[str, Any]:
    return {
        "状态": "正常",
        "系统": "杰哥智能化系统v3",
        "服务": "01智能体大脑",
        "阶段": "第一阶段最小可运行版本",
        "时间": 当前时间(),
        "说明": "此服务仅用于v3新系统测试，不接管旧系统生产流量。",
    }


@app.get("/health")
def health() -> Response:
    return Response(
        content=json.dumps(健康检查(), ensure_ascii=False),
        media_type="application/json; charset=utf-8",
    )


@app.post("/任务识别")
def 任务识别接口(请求: dict[str, Any]) -> dict[str, Any]:
    文本 = 请求.get("文本") or 请求.get("message") or 请求.get("content") or ""
    元数据 = 请求.get("元数据") or {}
    return {
        "状态": "成功",
        "时间": 当前时间(),
        "结果": 识别任务(文本, 元数据),
    }


@app.post("/模型/选择")
def 模型选择接口(请求: dict[str, Any]) -> dict[str, Any]:
    if "任务识别结果" in 请求:
        识别结果 = 请求.get("任务识别结果") or {}
    else:
        文本 = 请求.get("文本") or 请求.get("message") or 请求.get("content") or ""
        识别结果 = 识别任务(文本, 请求.get("元数据") or {})

    return {
        "状态": "成功",
        "时间": 当前时间(),
        "任务识别结果": 识别结果,
        "模型路由结果": 选择模型(识别结果, 请求.get("偏好") or {}),
    }


@app.get("/模型/列表")
def 模型列表接口() -> dict[str, Any]:
    return {
        "状态": "成功",
        "时间": 当前时间(),
        "Ollama": 读取模型列表(),
    }


