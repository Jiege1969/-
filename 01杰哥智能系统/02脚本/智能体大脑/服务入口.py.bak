@app.post("/思考")
def 思考接口(请求: dict[str, Any]) -> dict[str, Any]:
    文本 = 请求.get("文本") or 请求.get("message") or 请求.get("content") or ""
    识别结果 = 识别任务(文本, 请求.get("元数据") or {})
    路由结果 = 选择模型(识别结果, 请求.get("偏好") or {})
    能力规划结果 = 规划能力调用(识别结果)
    工作流规划结果 = 规划工作流(识别结果)
    系统提示 = 获取系统提示词(识别结果.get("任务类型", "普通对话"), 请求.get("系统提示"))
    最大输出 = 请求.get("最大输出") or 请求.get("num_predict") or 256
    温度 = 请求.get("温度") or 请求.get("temperature") or 0.2
    超时秒 = 请求.get("超时秒") or 请求.get("timeout") or 180

    if 路由结果.get("需要人工确认"):
        推理结果 = {
            "状态": "跳过",
            "答复": "",
            "完成原因": "任务风险等级高，需要人工确认后再调用模型。",
        }
    else:
        推理结果 = 生成文本(
            路由结果.get("首选模型", "qwen3:14b"),
            文本,
            系统提示=系统提示,
            最大输出=int(最大输出),
            温度=float(温度),
            超时秒=int(超时秒),
        )

    return {
        "状态": "成功",
        "时间": 当前时间(),
        "任务识别结果": 识别结果,
        "模型路由结果": 路由结果,
        "能力规划结果": 能力规划结果,
        "工作流规划结果": 工作流规划结果,
        "股票研究上下文": {
            "状态": 股票研究状态(),
            "计划": 读取股票研究计划() if 识别结果.get("任务类型") == "股票研究" else None,
            "风险摘要": 读取股票风险摘要() if 识别结果.get("任务类型") == "股票研究" else None,
        },
        "视频制作上下文": {
            "状态": 视频制作状态(),
            "计划": 读取视频制作计划() if 识别结果.get("任务类型") == "视频制作" else None,
            "脚本草稿": 读取视频脚本草稿() if 识别结果.get("任务类型") == "视频制作" else None,
            "分镜计划": 读取视频分镜计划() if 识别结果.get("任务类型") == "视频制作" else None,
        },
        "本职工作上下文": {
            "状态": 本职工作状态(),
            "计划": 读取办公材料计划() if 识别结果.get("任务类型") == "本职工作" else None,
            "草稿框架": 读取办公材料草稿框架() if 识别结果.get("任务类型") == "本职工作" else None,
        },
        "税收业务上下文": {
            "状态": 税收业务状态(),
            "分类索引": 读取税种分类索引() if 识别结果.get("任务类型") == "税收业务" else None,
            "政策案例索引": 读取税收政策案例索引() if 识别结果.get("任务类型") == "税收业务" else None,
            "处理计划": 读取税收业务处理计划() if 识别结果.get("任务类型") == "税收业务" else None,
        },
        "提示词来源": "请求覆盖" if 请求.get("系统提示") else "提示词模板.json",
        "推理结果": 推理结果,
        "答复": 推理结果.get("答复") or "已完成任务识别和模型路由；模型推理未产生答复。",
    }
