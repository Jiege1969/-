{
  "名称": "税收企业微信消息合规审查规则",
  "版本": "2026-05-07",
  "定位": "企业微信正式入口发送前的消息内容合规审查规则。只审查待复核消息是否越界，不生成税务结论。",
  "必须包含": [
    "【税收分析助手-待复核草案摘要】",
    "事项：",
    "状态：",
    "置信度：",
    "政策依据候选：",
    "依据层级明细：",
    "待复核资料清单：",
    "资料缺口：",
    "风险点：",
    "人工复核：",
    "边界：待复核草案摘要预演"
  ],
  "禁止短语": [
    "可以享受研发费用加计扣除",
    "不能享受研发费用加计扣除",
    "可以享受",
    "不能享受",
    "应当享受",
    "不得享受",
    "可扣除金额",
    "税额影响",
    "退税金额",
    "正式税务意见",
    "请立即申报",
    "请办理退税",
    "请开票",
    "无需人工复核"
  ],
  "敏感信息模式": [
    {
      "名称": "企业微信Webhook",
      "正则": "https://qyapi\\.weixin\\.qq\\.com/cgi-bin/webhook/send\\?key=[A-Za-z0-9_-]+"
    },
    {
      "名称": "手机号",
      "正则": "\\b1[3-9]\\d{9}\\b"
    },
    {
      "名称": "身份证号",
      "正则": "\\b\\d{17}[\\dXx]\\b"
    },
    {
      "名称": "长账号或纳税人编号",
      "正则": "\\b[0-9A-Z]{15,20}\\b"
    }
  ],
  "长度限制": {
    "最大字符数": 1800
  },
  "安全边界": {
    "是否生成正式税务结论": false,
    "是否读取凭据": false,
    "是否企业微信真实发送": false,
    "是否接电子税务局": false,
    "是否接财税软件": false,
    "是否触发n8n": false
  }
}
