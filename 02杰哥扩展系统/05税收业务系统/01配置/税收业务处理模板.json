{
  "说明": "税收业务处理模板。用于把具体业务问题转成可复核的处理流程。",
  "创建日期": "2026-04-26",
  "处理流程": [
    "一、事实采集",
    "二、税种识别",
    "三、政策匹配",
    "四、适用条件判断",
    "五、风险复核",
    "六、结论草案",
    "七、待核实事项"
  ],
  "事实采集字段": ["纳税人类型", "业务类型", "交易对象", "金额口径", "发票情况", "合同或凭证", "所属期间", "地区口径"],
  "结论输出要求": {
    "必须包含": ["适用税种", "政策依据", "判断过程", "风险点", "待核实事项"],
    "禁止": ["缺少政策来源", "跳过事实采集", "直接给确定性处理结论"]
  }
}
