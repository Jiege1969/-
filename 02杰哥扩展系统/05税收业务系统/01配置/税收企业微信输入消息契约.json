{
  "名称": "税收企业微信输入消息契约",
  "版本": "2026-05-08",
  "所属系统": "02杰哥扩展系统/05税收业务系统",
  "机器人终端": "杰哥工作秘书",
  "定位": "规范用户通过企业微信机器人向税收业务系统提出问题时的输入结构。只负责输入标准化、脱敏、排队和待分析标记，不直接生成税务结论。",
  "资产身份": "输入契约，不是正式业务规则，不是税务结论库，不是企业微信回调服务。",
  "输入状态词": [
    "received",
    "normalized",
    "pending_evidence_match",
    "pending_human_review",
    "rejected"
  ],
  "禁用状态词": [
    "confirmed_conclusion",
    "auto_filed",
    "auto_declared"
  ],
  "必填字段": [
    "消息ID",
    "接收时间",
    "机器人名称",
    "提问人标识",
    "原始问题",
    "问题摘要",
    "业务事项",
    "适用税种",
    "所属期间",
    "地区",
    "业务事实",
    "附件提示",
    "脱敏状态",
    "输入状态",
    "待补充字段",
    "禁止动作",
    "来源通道"
  ],
  "业务事实字段": [
    "纳税人类型",
    "企业主体",
    "事项类型",
    "金额口径",
    "资料来源",
    "已提供资料",
    "尚缺资料"
  ],
  "附件提示字段": [
    "是否提到附件",
    "附件名称",
    "附件类型",
    "附件是否已入库",
    "附件待处理事项"
  ],
  "脱敏规则": {
    "必须脱敏": [
      "手机号",
      "身份证号",
      "银行账号",
      "纳税人识别号",
      "企业微信Webhook",
      "电子税务局账号密码",
      "财税软件账号密码"
    ],
    "脱敏占位符": "[已脱敏]",
    "不得写入原文敏感值": true
  },
  "输入分流规则": [
    {
      "分流": "涉税业务分析",
      "条件": "包含税种、业务事项、政策适用、资料缺口、风险提示等问题",
      "下一状态": "pending_evidence_match"
    },
    {
      "分流": "资料补充",
      "条件": "用户补充事实、附件、期间、金额口径或地区信息",
      "下一状态": "normalized"
    },
    {
      "分流": "非税务或办税执行",
      "条件": "要求登录电子税务局、申报、退税、开票、直接办理事项",
      "下一状态": "rejected"
    }
  ],
  "禁止动作": [
    "不登录电子税务局",
    "不接财税软件",
    "不申报、不退税、不开票",
    "不输出正式税务意见",
    "不把输入问题直接转成确定性税务结论",
    "不把未脱敏敏感信息写入报告"
  ],
  "安全边界": {
    "是否接收真实企业微信回调": false,
    "是否联网": false,
    "是否读取凭据": false,
    "是否企业微信真实发送": false,
    "是否生成正式税务结论": false,
    "是否触发n8n": false,
    "是否接电子税务局": false,
    "是否接财税软件": false
  }
}
