    "请求登录电子税务局、申报、退税、开票或直接办税执行",
    "消息体超过长度限制",
    "附件类型不在允许范围"
  ],
  "允许附件类型": [
    "pdf",
    "docx",
    "xlsx",
    "csv",
    "txt",
    "图片待人工转写"
  ],
  "审计要求": [
    "每条入队消息必须生成审计编号",
