    "输入契约状态",
    "处理状态",
    "来源通道",
    "审计编号"
  ],
  "处理状态词": [
    "queued",
    "normalized",
    "rejected",
    "pending_evidence_match",
    "pending_human_review"
  ],
  "拒收条件": [
    "验签失败",
    "机器人名称不是杰哥工作秘书",
