      "完成输入消息契约验收",
      "完成接收审计和回滚预案"
    ]
  },
  "回调验签字段": [
    "msg_signature",
    "timestamp",
    "nonce",
    "echostr"
  ],
  "消息入队字段": [
    "入队ID",
    "消息ID",
    "接收时间",
    "机器人名称",
    "提问人标识",
    "消息类型",
    "原始文本脱敏版",
