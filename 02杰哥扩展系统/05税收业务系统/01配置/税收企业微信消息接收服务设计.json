  "资产身份": "接收服务设计，不是运行中服务，不是企业微信回调地址，不是凭据配置。",
  "服务状态": "design_only",
  "默认端口策略": {
    "是否新增端口": false,
    "建议仅本机监听": true,
    "候选本机地址": "127.0.0.1",
    "候选路径": "/wecom/work-secretary",
    "税收内部队列目标": "税收企业微信本地输入队列预演",
    "路径口径": "企业微信公网回调路径统一使用公共组件杰哥工作秘书 /wecom/work-secretary；税收系统不另开公网回调，只接收公共路由后的本地队列输入。",
    "真实部署前要求": [
      "明确公网入口或内网网关",
      "配置企业微信应用回调Token和EncodingAESKey",
