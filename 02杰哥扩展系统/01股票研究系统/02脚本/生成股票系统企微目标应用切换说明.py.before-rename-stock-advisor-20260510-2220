# -*- coding: utf-8 -*-
"""
名称：生成股票系统企微目标应用切换说明.py
作用：区分企业微信自建应用发送目标与股票智能机器人前台终端，生成当前启用状态说明。
触发方式：python 生成股票系统企微目标应用切换说明.py
依赖：企业微信应用目标档案、企业微信受控发送配置、企业微信本机环境、杰哥股票顾问前台入口配置。
所属系统：02杰哥扩展系统/01股票研究系统
安全边界：只读配置和本机健康状态；不输出密钥值；不调用企业微信API；不发送消息；不触发n8n；不调用券商接口；不自动交易。
标识：stock-wecom-target-app-switch-guide
"""

from __future__ import annotations

import json
import urllib.request
from datetime import datetime
from pathlib import Path
from typing import Any


STOCK_ROOT = Path(__file__).resolve().parents[1]
COMMON_ROOT = STOCK_ROOT.parents[0] / "00公共组件"
PROFILE_PATH = COMMON_ROOT / "01配置" / "企业微信应用目标档案.json"
SEND_CONFIG_PATH = COMMON_ROOT / "01配置" / "企业微信受控发送配置.json"
LOCAL_ENV_PATH = COMMON_ROOT / "01配置" / "企业微信本机环境.env"
PRIVATE_CONFIG_PATH = COMMON_ROOT / "企业微信接入设置" / "01配置" / "企业微信助手私密配置_本机.json"
FRONT_CONFIG_PATH = STOCK_ROOT / "01配置" / "杰哥股票顾问前台入口配置.json"
OUTPUT_DIR = STOCK_ROOT / "03数据" / "164企微目标应用切换"
ENTRY_BAT = STOCK_ROOT / "05入口工具" / "股票系统企微目标应用切换说明_打开.bat"

STOCK_ADVISOR_NAME = "杰哥股票顾问"
STOCK_ADVISOR_LOCAL_ENDPOINT = "http://127.0.0.1:19302/wecom-bot/message"
STOCK_ADVISOR_PUBLIC_CALLBACK = "http://43.167.210.211/wecom-bot/message"


def load_json(path: Path, default: Any = None) -> Any:
    if not path.exists():
        return default
    return json.loads(path.read_text(encoding="utf-8-sig"))


def write_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")


def write_json(path: Path, data: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")


def parse_env(path: Path) -> dict[str, str]:
    result: dict[str, str] = {}
    if not path.exists():
        return result
    for line in path.read_text(encoding="utf-8-sig", errors="replace").splitlines():
        text = line.strip()
        if not text or text.startswith("#") or "=" not in text:
            continue
        key, value = text.split("=", 1)
        result[key.strip()] = value.strip().strip('"').strip("'")
    return result


def has_value(value: Any) -> bool:
    text = str(value or "").strip()
    return bool(text and text not in {"待填写", "请填写", "TODO", "todo", "未配置", "***"})


def profile_status(name: str, profile: dict[str, Any], env: dict[str, str]) -> dict[str, Any]:
    corp_var = profile.get("企业ID变量", "WECOM_CORP_ID")
    agent_var = profile.get("应用ID变量", "")
    secret_var = profile.get("应用密钥变量", "")
    return {
        "应用名称": name,
        "状态": profile.get("状态", ""),
        "企业ID变量": corp_var,
        "应用ID变量": agent_var,
        "应用密钥变量": secret_var,
        "企业ID已配置": has_value(env.get(corp_var, "")),
        "应用ID已配置": has_value(env.get(agent_var, "")),
        "应用密钥已配置": has_value(env.get(secret_var, "")),
        "可作为发送目标": has_value(env.get(corp_var, "")) and has_value(env.get(agent_var, "")) and has_value(env.get(secret_var, "")),
    }


def find_private_assistant(name: str) -> dict[str, Any]:
    data = load_json(PRIVATE_CONFIG_PATH, {}) or {}
    for item in data.get("助手", []):
        if isinstance(item, dict) and item.get("名称") == name:
            return item
    return {}


def local_get_status(url: str, timeout: int = 5) -> dict[str, Any]:
    try:
        request = urllib.request.Request(url, headers={"User-Agent": "jiege-stock-wecom-enable-check/1.0"})
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return {"ok": 200 <= response.status < 300, "status": response.status}
    except Exception as exc:  # noqa: BLE001
        return {"ok": False, "status": 0, "error": exc.__class__.__name__}


def stock_advisor_status(env: dict[str, str]) -> dict[str, Any]:
    front_config = load_json(FRONT_CONFIG_PATH, {}) or {}
    terminal = front_config.get("企业微信终端", {}) if isinstance(front_config, dict) else {}
    private_item = find_private_assistant(STOCK_ADVISOR_NAME)

    bot_id_ok = has_value(terminal.get("BotID")) or has_value(env.get("WECOM_STOCK_ADVISOR_BOT_ID")) or has_value(private_item.get("BotID"))
    secret_ok = has_value(env.get("WECOM_STOCK_ADVISOR_SECRET")) or has_value(private_item.get("Secret"))
    token_ok = (
        has_value(env.get("WECOM_STOCK_ADVISOR_CALLBACK_TOKEN"))
        or has_value(env.get("WECOM_BOT_CALLBACK_TOKEN"))
        or has_value(private_item.get("Token"))
    )
    aes_ok = (
        has_value(env.get("WECOM_STOCK_ADVISOR_CALLBACK_AES_KEY"))
        or has_value(env.get("WECOM_BOT_CALLBACK_AES_KEY"))
        or has_value(private_item.get("EncodingAESKey"))
    )
    bridge_health = local_get_status("http://127.0.0.1:19302/health")
    assistant_health = local_get_status("http://127.0.0.1:19300/health")
    reco_page = local_get_status(f"{STOCK_ADVISOR_LOCAL_ENDPOINT}?view=stock-reco")

    checks = [
        {"检查项": "前台入口配置存在", "通过": FRONT_CONFIG_PATH.exists(), "说明": str(FRONT_CONFIG_PATH)},
        {"检查项": "BotID已配置", "通过": bot_id_ok, "说明": "只检查是否存在，不输出值"},
        {"检查项": "Secret已配置", "通过": secret_ok, "说明": "只检查是否存在，不输出值"},
        {"检查项": "回调Token已配置", "通过": token_ok, "说明": "优先专用变量，允许沿用股票机器人通用变量"},
        {"检查项": "EncodingAESKey已配置", "通过": aes_ok, "说明": "优先专用变量，允许沿用股票机器人通用变量"},
        {"检查项": "股票企微桥接19302在线", "通过": bridge_health["ok"], "说明": bridge_health},
        {"检查项": "股票助手19300在线", "通过": assistant_health["ok"], "说明": assistant_health},
        {"检查项": "杰哥推荐图文页可打开", "通过": reco_page["ok"], "说明": reco_page},
    ]
    enabled = all(item["通过"] for item in checks)
    return {
        "终端名称": STOCK_ADVISOR_NAME,
        "终端类型": "企业微信智能机器人股票专用前台终端",
        "本地入口": STOCK_ADVISOR_LOCAL_ENDPOINT,
        "推荐图文入口": f"{STOCK_ADVISOR_LOCAL_ENDPOINT}?view=stock-reco",
        "公网回调建议填写": STOCK_ADVISOR_PUBLIC_CALLBACK,
        "前台终端已启用": enabled,
        "检查": checks,
        "缺口": [item["检查项"] for item in checks if not item["通过"]],
        "说明": "这是智能机器人回调入口，不是企业微信自建应用主动发送目标。",
    }


def yes_no(value: bool) -> str:
    return "是" if value else "否"


def main() -> int:
    now = datetime.now()
    stamp = now.strftime("%Y%m%d_%H%M%S")
    profiles = load_json(PROFILE_PATH, {}) or {}
    send_config = load_json(SEND_CONFIG_PATH, {}) or {}
    env = parse_env(LOCAL_ENV_PATH)

    profile_map = profiles.get("应用档案", {}) if isinstance(profiles, dict) else {}
    statuses = [profile_status(name, profile, env) for name, profile in profile_map.items()]
    current_app = profiles.get("当前启用应用", "未配置") if isinstance(profiles, dict) else "未配置"
    target_app = next((item for item in statuses if item["应用名称"] == "杰哥助手"), None)
    target_app_can_switch = bool(target_app and target_app["可作为发送目标"])
    advisor = stock_advisor_status(env)

    report = {
        "名称": "股票系统企微前台终端启用状态",
        "生成时间": now.strftime("%Y-%m-%d %H:%M:%S"),
        "当前启用应用": current_app,
        "当前股票前台终端": STOCK_ADVISOR_NAME,
        "股票前台终端已启用": advisor["前台终端已启用"],
        "目标应用": "杰哥助手",
        "目标应用可切换": target_app_can_switch,
        "口径区分": {
            "企业微信自建应用主动发送": "由企业微信应用目标档案和受控发送器管理，当前仍是既有发送通道。",
            "股票智能机器人前台回调": "由杰哥股票顾问前台入口配置和 /wecom-bot/message 管理，当前应使用杰哥股票顾问。",
        },
        "档案文件": str(PROFILE_PATH),
        "受控发送配置": str(SEND_CONFIG_PATH),
        "本机环境文件": str(LOCAL_ENV_PATH),
        "前台入口配置": str(FRONT_CONFIG_PATH),
        "私密配置文件": str(PRIVATE_CONFIG_PATH),
        "自建应用状态": statuses,
        "股票顾问前台终端状态": advisor,
        "受控发送配置摘要": {
            "真实发送开关": bool((send_config.get("真实发送") or {}).get("是否启用")),
            "允许群发": bool((send_config.get("真实发送") or {}).get("允许群发")),
            "允许外部客户": bool((send_config.get("真实发送") or {}).get("允许外部客户")),
            "当前启用应用": (send_config.get("凭据来源") or {}).get("当前启用应用", current_app),
        },
        "安全边界": {
            "输出密钥值": False,
            "调用企业微信API": False,
            "真实发送企业微信": False,
            "触发n8n": False,
            "调用券商接口": False,
            "自动交易": False,
        },
    }

    md = [
        "# 股票系统企微前台终端启用状态",
        "",
        f"- 生成时间：{report['生成时间']}",
        f"- 当前股票前台终端：{STOCK_ADVISOR_NAME}",
        f"- 股票前台终端是否已启用：{yes_no(advisor['前台终端已启用'])}",
        f"- 智能机器人本地入口：`{STOCK_ADVISOR_LOCAL_ENDPOINT}`",
        f"- 企业微信后台回调URL建议填写：`{STOCK_ADVISOR_PUBLIC_CALLBACK}`",
        f"- 自建应用主动发送当前启用应用：{current_app}",
        "",
        "## 当前判断",
        "",
    ]
    if advisor["前台终端已启用"]:
        md.append("杰哥股票顾问已经作为股票系统前台智能机器人启用：本机配置、桥接入口、股票助手入口和推荐图文页均可用。")
    else:
        md.append("杰哥股票顾问登记存在，但前台启用检查仍有缺口，需要先补齐下列项目。")
    md.extend([
        "",
        "注意：`当前启用应用` 是自建应用主动发送口径，不等于股票智能机器人前台终端。不要把杰哥股票顾问硬切成自建应用发送目标。",
        "",
        "## 股票顾问检查",
        "",
        "| 检查项 | 通过 | 说明 |",
        "|---|---:|---|",
    ])
    for item in advisor["检查"]:
        md.append(f"| {item['检查项']} | {yes_no(bool(item['通过']))} | {item['说明']} |")
    md.extend([
        "",
        "## 自建应用发送口径",
        "",
        "| 应用 | 状态 | 企业ID | AgentId | Secret | 可主动发送 |",
        "|---|---|---:|---:|---:|---:|",
    ])
    for item in statuses:
        md.append(
            f"| {item['应用名称']} | {item['状态']} | "
            f"{'已配置' if item['企业ID已配置'] else '缺失'} | "
            f"{'已配置' if item['应用ID已配置'] else '缺失'} | "
            f"{'已配置' if item['应用密钥已配置'] else '缺失'} | "
            f"{yes_no(bool(item['可作为发送目标']))} |"
        )
    md.extend([
        "",
        "## 如果企业微信手机端仍找不到",
        "",
        "1. 到企业微信管理后台确认智能机器人名称就是“杰哥股票顾问”。",
        f"2. 回调URL填：`{STOCK_ADVISOR_PUBLIC_CALLBACK}`。",
        "3. Token、EncodingAESKey、BotID 与本机私密配置保持一致；不要把 Secret 发到聊天里。",
        "4. 保存后，用企业微信给该机器人发“杰哥推荐”或“分析 永鼎股份”验证。",
        "",
        "## 安全边界",
        "",
        "- 本说明脚本不调用企业微信 API。",
        "- 本说明脚本不发送任何企业微信消息。",
        "- 本说明脚本不输出任何明文密钥。",
        "- 本说明脚本不触发 n8n、不调用券商接口、不自动交易。",
    ])

    output_json = OUTPUT_DIR / f"股票系统企微目标应用切换说明_{stamp}.json"
    output_md = OUTPUT_DIR / f"股票系统企微目标应用切换说明_{stamp}.md"
    latest_json = OUTPUT_DIR / "股票系统企微目标应用切换说明_最新.json"
    latest_md = OUTPUT_DIR / "股票系统企微目标应用切换说明_最新.md"
    write_json(output_json, report)
    write_json(latest_json, report)
    write_text(output_md, "\n".join(md))
    write_text(latest_md, "\n".join(md))
    write_text(ENTRY_BAT, f'@echo off\r\nstart "" "{latest_md}"\r\n')
    print(json.dumps({
        "ok": advisor["前台终端已启用"],
        "股票前台终端已启用": advisor["前台终端已启用"],
        "缺口": advisor["缺口"],
        "报告": str(latest_md),
        "入口工具": str(ENTRY_BAT),
    }, ensure_ascii=False))
    return 0 if advisor["前台终端已启用"] else 2


if __name__ == "__main__":
    raise SystemExit(main())
