  "fields": [
    {
      "name": "candidate_id",
      "required": true,
      "description": "候选事件ID，例如POL-CAND-20260507-001。"
    },
    {
      "name": "reviewer",
      "required": true,
      "description": "人工复核人。"
    },
    {
      "name": "reviewed_at",
      "required": true,
      "description": "复核日期，格式YYYY-MM-DD。"
    },
    {
      "name": "source_verified",
      "required": true,
      "description": "官方来源是否核验通过。"
    },
    {
      "name": "source_note",
      "required": true,
      "description": "来源核验备注，包括标题、发布时间、实施日期是否一致。"
    },
    {
      "name": "impact_direction_final",
      "required": true,
      "description": "复核后的影响方向：利好/利空/中性/不确定。"
    },
    {
      "name": "impact_strength_final",
      "required": true,
      "description": "复核后的影响强度，0-1。没有充分理由时不得超过0.30。"
    },
    {
      "name": "impact_mechanism",
      "required": true,
      "description": "影响机制：资源价格弹性、出口约束、合规成本、订单扰动、长期制度约束等。"
    },
    {
      "name": "duplicate_scoring_risk",
      "required": true,
      "description": "是否存在与已入库事件重复计分风险。"
    },
    {
      "name": "duplicate_scoring_note",
      "required": true,
      "description": "如存在重复，说明新增边际影响；否则只能作为背景证据。"
    },
    {
      "name": "stock_exposure_reviewed",
      "required": true,
      "description": "股票暴露度是否逐只复核。"
    },
    {
      "name": "admission_decision",
      "required": true,
      "description": "keep_draft / evidence_ready / exposure_reviewed / reject。"
    },
    {
      "name": "remaining_missing",
      "required": true,
      "description": "仍缺哪些证据。"
    },
    {
      "name": "next_action",
      "required": true,
      "description": "下一步动作，例如补公司年报、补产品参数、补出口占比。"
    }
  ],
