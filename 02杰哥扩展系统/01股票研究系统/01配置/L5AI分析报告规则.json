{
  "名称": "L5AI分析报告规则",
  "版本": "2026-05-01",
  "定位": "读取已确认的L5深度研究池，调用本地Ollama模型生成结构化AI分析报告。报告只作研究参考，不构成投资建议。",
  "输入": {
    "L5深度研究池": "03数据/134深度研究池/L5深度研究池_最新.json",
    "人工确认结果": "03数据/135分层日报/L5人工确认结果_最新.json"
  },
  "输出": {
    "分层日报目录": "03数据/135分层日报",
    "日志目录": "04日志/人工闸口",
    "Markdown文件前缀": "AI分析报告",
    "JSON文件前缀": "AI分析报告"
  },
  "人工闸口": {
    "必须确认": true,
    "允许本地自动确认参数": true,
    "默认命令": "确认开始",
    "追加股票必须来自L7": true
  },
  "模型路由": {
    "ollama_url": "http://127.0.0.1:29134",
    "默认分析模型": "qwen3:14b",
    "复杂推理模型": "deepseek-r1:32b",
    "快速兜底模型": "qwen2.5:7b",
    "单只超时秒": 90,
    "复杂模型超时秒": 120,
    "启用复杂模型": true,
    "复杂触发条件": {
      "风险标记数量大于等于": 2,
      "放量率大于": 1.0,
      "RSI大于": 75,
      "存在涨跌停标记": true
    }
  },
  "分析维度": [
    "基本信息",
    "入选原因",
    "技术结构",
    "资金活跃",
    "行业背景",
    "风险提示",
    "证据状态",
    "研究小结"
  ],
  "允许输出": [
    "继续跟踪",
    "暂缓观察",
    "需人工确认",
    "技术面偏强",
    "资金活跃",
    "风险提示"
  ],
  "禁止输出": [
    "买入",
    "卖出",
    "持有",
    "仓位建议",
    "目标价",
    "收益承诺",
    "明确交易指令"
  ],
  "安全边界": {
    "是否自动交易": false,
    "是否调用券商接口": false,
    "是否触发n8n": false,
    "是否企业微信真实发送": false,
    "是否写旧系统": false,
    "是否写正式库": false
  }
}
