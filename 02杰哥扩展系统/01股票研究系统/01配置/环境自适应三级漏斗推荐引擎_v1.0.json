{
  "名称": "环境自适应三级漏斗推荐引擎",
  "版本": "v1.0",
  "生效日期": "2026-05-10",
  "所属系统": "02杰哥扩展系统/01股票研究系统",
  "定位": "把现有市场环境、行业归因、量价方法分、失败对照和风险刹车整合为影子推荐引擎，输出优先行业、重点关注个股、观察验证个股和暂缓对象。",
  "运行模式": "影子运行",
  "上位规则": [
    "01配置/股票通用分析判断机制_v1.0.json",
    "01配置/股票指标智能选择与方法切换规则_v1.0.json"
  ],
  "不推翻的既有资产": [
    "03数据/273杰哥推荐行业归因/杰哥推荐行业归因报告_最新.json",
    "03数据/280杰哥推荐分析方法v1/全候选方法评分_最新.json",
    "03数据/278杰哥推荐方法内核校准/杰哥推荐方法内核校准报告_最新.json",
    "03数据/282股票指标智能选择引擎/股票指标智能选择引擎_最新.json"
  ],
  "核心流程": [
    "第0层：数据可信层，检查输入产物是否存在、数量是否达标。",
    "第1层：环境状态识别，读取当前市场状态并生成状态概率。",
    "第2层：判断线权重调度，按状态概率平滑分配市场、行业、个股、趋势、量价、风险权重。",
    "第3层：三级漏斗筛选，先市场定宽严，再行业定方向，最后行业内筛个股。",
    "第4层：个股独立强度校验，防止只选到行业贝塔。",
    "第5层：风险结论上限，失败对照和风险刹车限制推荐层级。",
    "第6层：复盘任务预留，记录当时状态、权重和结论。"
  ],
