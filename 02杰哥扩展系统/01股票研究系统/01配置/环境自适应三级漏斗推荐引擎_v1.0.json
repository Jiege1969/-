    },
    "观察验证上限": {
      "趋势市": 24,
      "震荡市": 18,
      "弱势市": 10,
      "恐慌市": 6
    },
    "重点最低综合分": 82,
    "观察最低综合分": 70,
    "重点必须核心门槛通过": true,
    "重点必须无P0刹车": true
  },
  "结论上限规则": [
    {
      "条件": "核心门槛未通过",
      "结论上限": "观察验证",
      "说明": "趋势、失败对照、行业逆风等宪法层门槛未通过，不能进入重点。"
    },
    {
      "条件": "存在刹车项",
      "结论上限": "观察验证",
      "说明": "任何P0或方法刹车项优先限制层级。"
    },
    {
      "条件": "行业弱势或失败集中",
      "结论上限": "观察验证",
      "说明": "行业逆风下个股再强也先观察验证。"
    },
    {
      "条件": "行业高拥挤",
      "结论上限": "重点待验证",
      "说明": "行业热度从加分转为风险，不能直接强推。"
    }
  ],
  "安全边界": {
