{
  "名称": "候选池生成规则",
  "作用": "根据重点关注池技术指标生成L5深度研究、L6轻度关注和L7过滤候选池。",
  "触发方式": "由生成重点关注池候选池.py读取。",
  "依赖": "重点关注池技术指标_最新.json；分层过滤规则.json；复盘账本运行规则.json。",
  "所属系统": "02杰哥扩展系统/01股票研究系统",
  "创建修改记录": "2026-04-28 创建候选池生成规则第一版。",
  "默认开关": {
    "允许读取技术指标": true,
    "允许生成候选池": true,
    "允许生成候选报告": true,
    "允许调用大模型": false,
    "允许写旧系统": false,
    "允许触发n8n": false,
    "允许企业微信真实发送": false,
    "允许调用券商接口": false,
    "允许自动交易": false
  },
  "评分规则": {
    "基础分": 50,
    "站上MA60": 18,
    "低于MA60": -12,
    "MA5大于MA10": 8,
    "MA10大于MA20": 6,
    "RSI40到70": 14,
    "RSI大于70": -5,
    "RSI小于40": -10,
    "MACD强": 12,
    "MACD弱": -8,
    "量比1点1到2点5": 8,
    "量比大于3点5": -5,
    "数据不足": -30
  },
  "分层阈值": [
    {"最低分": 75, "层级": "L5深度研究", "动作": "生成深度研究候选，不自动升级L4"},
    {"最低分": 60, "层级": "L6轻度关注", "动作": "保持跟踪"},
    {"最低分": 0, "层级": "L7系统过滤", "动作": "记录过滤原因"}
  ],
  "输出路径": {
    "候选池": "03数据/14候选池",
    "候选报告": "03数据/03研究报告"
  },
  "验收标准": [
    "能够读取最新技术指标",
    "能够为每只重点关注股票给出分数、层级、依据和风险",
    "L5仅作为深度研究候选，不自动升级L4",
    "数据不足股票必须记录原因",
    "不调用大模型、不自动交易、不写旧系统"
  ]
}
