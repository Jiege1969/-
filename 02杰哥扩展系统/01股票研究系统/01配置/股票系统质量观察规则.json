{
  "名称": "股票系统质量观察规则",
  "版本": "2026-05-01",
  "作用": "定义股票主动研究系统质量观察面板和历史账本的黄灯、红灯判定口径。",
  "安全边界": {
    "是否触发n8n": false,
    "是否企业微信真实发送": false,
    "是否调用券商接口": false,
    "是否自动交易": false
  },
  "绿灯": {
    "L5输出数量等于目标": true,
    "AI错误数量": 0,
    "AI规则兜底数上限": 0,
    "AI降级数量上限": 0,
    "最高行业集中数量上限": 3
  },
  "黄灯": {
    "L5输出数量低于目标但不低于": 5,
    "AI规则兜底数上限": 2,
    "AI降级数量上限": 2,
    "AI错误数量上限": 1,
    "最高行业集中数量上限": 4,
    "成交额估算数量提示": true,
    "复杂模型禁用提示": true
  },
  "红灯": {
    "L5输出数量低于": 5,
    "AI错误数量大于": 1,
    "AI规则兜底数大于": 2,
    "AI模型成功数低于": 8,
    "最高行业集中数量大于": 4,
    "关键文件缺失": true
  },
  "外部阻断": {
    "企业微信真实主动推送未通过": "单独标记为外部阻断，不影响本地日常可用结论",
    "可信IP白名单缺失": "单独标记为外部阻断"
  }
}
