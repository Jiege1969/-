{
  "名称": "L6行业主题观察池规则",
  "版本": "2026-05-01",
  "定位": "读取L7可交易过滤池，结合行业强度、资金活跃度、技术表现和用户增强标记，生成L6行业主题观察池。",
  "输入": {
    "L7可交易过滤池": "03数据/132可交易过滤池/L7可交易过滤池_最新.json",
    "用户增强观察池": "03数据/131用户增强观察池/用户增强观察池_最新.json"
  },
  "输出": {
    "数据目录": "03数据/133行业主题观察池",
    "最新文件": "L6行业主题观察池_最新.json"
  },
  "目标规模": {
    "L6默认数量": 80,
    "最小数量": 50,
    "最大数量": 100
  },
  "评分权重": {
    "行业强度": 0.4,
    "资金活跃度": 0.3,
    "技术面": 0.2,
    "用户增强加分": 0.2
  },
  "组成配比": {
    "强势行业资金活跃": 0.7,
    "用户增强观察池": 0.2,
    "异常强势个股": 0.1
  },
  "行业规则": {
    "行业强度方法": "L7成分股等权估算",
    "强势行业比例": 0.3,
    "行业最小成分数": 3,
    "行业缓存文件": "03数据/133行业主题观察池/行业映射缓存_最新.json"
  },
  "资金活跃度指标": {
    "主指标": "近5日日均成交额/近20日日均成交额-1",
    "异常强势放量率": 1.0,
    "最低近20日日均成交额_亿元": 1.0
  },
  "数据源": {
    "行业信息": "baostock query_stock_industry；AKShare stock_individual_info_em",
    "行业获取并发线程数": 4,
    "失败重试次数": 2
  },
  "安全边界": {
    "是否自动交易": false,
    "是否调用券商接口": false,
    "是否触发n8n": false,
    "是否企业微信真实发送": false,
    "是否写旧系统": false,
    "是否写正式库": false
  }
}
