{
  "名称": "技术指标计算规则",
  "作用": "定义重点关注池历史K线采集和技术指标计算规则。",
  "触发方式": "由生成重点关注池历史K线快照.py和计算重点关注池技术指标.py读取。",
  "依赖": "重点关注股票池.json；东方财富公开历史K线接口；Python标准库。",
  "所属系统": "02杰哥扩展系统/01股票研究系统",
  "创建修改记录": "2026-04-28 创建技术指标计算规则第一版。",
  "默认开关": {
    "允许公开只读联网": true,
    "允许使用缓存兜底": true,
    "允许写新系统历史行情": true,
    "允许写新系统指标结果": true,
    "允许写旧系统": false,
    "允许触发n8n": false,
    "允许企业微信真实发送": false,
    "允许调用券商接口": false,
    "允许自动交易": false
  },
  "历史K线": {
    "周期": "日线",
    "复权": "前复权",
    "目标交易日数量": 160,
    "最低可计算数量": 80,
    "字段": ["日期", "开盘", "收盘", "最高", "最低", "成交量", "成交额", "振幅", "涨跌幅", "涨跌额", "换手率"]
  },
  "指标参数": {
    "MA": [5, 10, 20, 60],
    "RSI": 14,
    "MACD": {"快线": 12, "慢线": 26, "信号线": 9},
    "成交量MA": 20,
    "量比周期": 5
  },
  "输出路径": {
    "历史K线": "03数据/11历史行情",
    "技术指标": "03数据/12技术指标"
  },
  "验收标准": [
    "能够为重点关注池生成历史K线快照",
    "能够为重点关注池生成技术指标结果",
    "每只股票至少具备最低可计算数量的K线或明确记录失败原因",
    "指标结果包含MA5、MA10、MA20、MA60、RSI14、MACD、成交量MA20",
    "不调用券商接口，不自动交易，不写旧系统"
  ]
}
