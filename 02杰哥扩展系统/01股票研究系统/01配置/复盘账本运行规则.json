{
  "名称": "复盘账本运行规则",
  "作用": "定义四本账从蓝图进入可运行状态的输入、输出和安全边界。",
  "触发方式": "由记录系统判断账.py、生成人工决策账模板.py、生成结果验证计划.py读取。",
  "依赖": "研究决策复盘闭环规则.json；重点关注股票池.json；重点关注池公开行情快照_最新.json。",
  "所属系统": "02杰哥扩展系统/01股票研究系统",
  "创建修改记录": "2026-04-28 创建复盘账本运行规则第一版。",
  "默认开关": {
    "允许读取公开行情快照": true,
    "允许生成系统判断账": true,
    "允许生成人工决策账模板": true,
    "允许生成结果验证计划": true,
    "允许生成经验提炼候选": true,
    "允许联网刷新行情": false,
    "允许写旧系统": false,
    "允许触发n8n": false,
    "允许企业微信真实发送": false,
    "允许调用券商接口": false,
    "允许自动交易": false
  },
  "评分规则": {
    "基础分": 50,
    "涨跌幅0到4": 8,
    "涨跌幅大于7": -6,
    "涨跌幅小于-5": -8,
    "量比1点1到2点5": 6,
    "量比大于4": -4,
    "换手率1到8": 4,
    "换手率大于15": -4,
    "市盈率大于90": -4
  },
  "分层规则": [
    {"最低分": 75, "层级": "L4观察候选建议", "权限": "必须人工确认"},
    {"最低分": 62, "层级": "L5深度研究", "权限": "系统可自动推荐"},
    {"最低分": 45, "层级": "L6轻度关注", "权限": "系统可自动维护"},
    {"最低分": 0, "层级": "L7系统过滤", "权限": "系统可自动过滤"}
  ],
  "反馈模板": [
    "确认L4：股票名称或代码，原因",
    "继续观察：股票名称或代码，原因",
    "暂不关注：股票名称或代码，原因",
    "无价值：股票名称或代码，原因",
    "系统看错：股票名称或代码，原因",
    "我判断错了：股票名称或代码，原因"
  ],
  "验证周期": ["T+1", "T+3", "T+5", "T+20"],
  "账本路径": {
    "系统判断账": "03数据/10复盘闭环/01系统判断账",
    "人工决策账": "03数据/10复盘闭环/02人工决策账",
    "结果验证账": "03数据/10复盘闭环/03结果验证账",
    "经验提炼账": "03数据/10复盘闭环/04经验提炼账"
  },
  "验收标准": [
    "能够从最新行情快照生成系统判断账",
    "能够生成可人工填写或消息解析的决策账模板",
    "能够生成T+1、T+3、T+5、T+20结果验证计划",
    "能够生成经验提炼候选空账本",
    "所有输出只写新股票系统目录",
    "真实动作默认关闭"
  ]
}
