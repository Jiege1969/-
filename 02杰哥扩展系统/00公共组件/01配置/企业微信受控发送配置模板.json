{
  "名称": "企业微信受控发送配置模板",
  "作用": "为统一消息出口提供企业微信真实发送的受控配置模板；默认关闭真实发送，不保存明文密钥。",
  "触发方式": "python 企业微信受控发送闸口.py --check-only",
  "依赖": "环境变量；统一消息出口；白名单配置",
  "所属系统": "02杰哥扩展系统/00公共组件",
  "创建修改记录": "2026-04-28 创建第一版企业微信受控发送配置模板。",
  "真实发送": {
    "是否启用": false,
    "首轮灰度最大消息数": 5,
    "允许群发": false,
    "允许外部客户": false,
    "允许非白名单接收人": false
  },
  "凭据来源": {
    "类型": "环境变量",
    "企业ID变量": "JIEGE_WEWORK_CORP_ID",
    "应用ID变量": "JIEGE_WEWORK_AGENT_ID",
    "应用密钥变量": "JIEGE_WEWORK_CORP_SECRET"
  },
  "白名单": {
    "接收人ID列表": [],
    "说明": "首轮只允许用户本人企业微信ID，最多5条测试消息；未填写实际ID时禁止真实发送。"
  },
  "禁止事项": {
    "保存明文密钥": true,
    "股票系统持有密钥": true,
    "绕过统一消息出口发送": true,
    "超过5条首轮测试消息": true,
    "群发": true,
    "外部客户发送": true,
    "自动交易": true
  }
}
