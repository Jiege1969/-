        return intention_route
    route_config = load_json(ROUTE_CONFIG_PATH, {})
    route = PREVIEW_MODULE.route_message(message, route_config)
    if str(route.get("路由") or "") == "澄清一次" and (looks_like_stock_message(message) or looks_like_investment_message(message)):
