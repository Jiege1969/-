        latest = alerts[:3]
        lines = [f"杰哥，查到了：{summary}"]
        if latest:
            lines.append("最近几条：")
            for item in latest:
                file_name = str(item.get("file") or "")
                date = str(item.get("date") or "")
                lines.append(f"- {date} {file_name}")
        lines.append("我只做本地只读查询，没有触发企微真实发送、n8n或业务执行。")
