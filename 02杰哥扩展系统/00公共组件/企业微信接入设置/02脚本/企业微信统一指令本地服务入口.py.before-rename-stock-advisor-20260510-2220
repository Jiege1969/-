def is_ping_message(message: str) -> bool:
    normalized = "".join(str(message).strip().lower().split())
    if not normalized:
        return False
    if normalized in {"ping", "ping一下", "在吗", "在线吗", "系统在线吗", "系统管家在线吗"}:
        return True
    return normalized.startswith("ping")


