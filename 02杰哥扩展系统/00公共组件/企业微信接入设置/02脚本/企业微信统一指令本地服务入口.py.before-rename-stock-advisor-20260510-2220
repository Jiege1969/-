def normalize_message(text: str) -> str:
    return re.sub(r"\s+", "", str(text).strip().lower())


def load_stock_terms() -> set[str]:
    data = load_json(STOCK_WATCH_POOL_JSON, {}) or {}
    terms: set[str] = set()
    for item in data.get("股票池", []):
        if not isinstance(item, dict):
            continue
        for key in ("名称", "代码", "展示代码"):
            value = str(item.get(key) or "").strip()
            if not value:
                continue
            terms.add(normalize_message(value))
            if len(value) >= 8 and value[:2].lower() in {"sh", "sz", "bj"}:
                terms.add(normalize_message(value[2:]))
    return {term for term in terms if len(term) >= 2}


