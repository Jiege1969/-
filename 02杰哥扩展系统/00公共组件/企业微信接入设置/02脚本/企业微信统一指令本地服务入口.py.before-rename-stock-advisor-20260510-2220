def post_local_json(url: str, payload: dict[str, Any], timeout: float = 8.0) -> dict[str, Any] | None:
    try:
        body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        request = urllib.request.Request(
            url,
            data=body,
            headers={"Content-Type": "application/json; charset=utf-8"},
            method="POST",
        )
        with urllib.request.urlopen(request, timeout=timeout) as response:  # noqa: S310 - localhost only
            return json.loads(response.read().decode("utf-8", errors="replace"))
    except Exception:  # noqa: BLE001
        return None


def get_local_json(url: str, timeout: float = 5.0) -> dict[str, Any] | None:
    try:
        with urllib.request.urlopen(url, timeout=timeout) as response:  # noqa: S310 - localhost only
            return json.loads(response.read().decode("utf-8", errors="replace"))
    except Exception:  # noqa: BLE001
        return None


def classify_by_intention_api(message: str) -> dict[str, Any] | None:
    result = post_local_json(INTENTION_API_URL, {"message": message}, timeout=25.0)
    if not result:
        return None
    target = str(result.get("target_robot") or "").strip()
    refined = str(result.get("refined_query") or "").strip()
    fallback = str(result.get("fallback_msg") or "").strip()
    mapping = {
        "股票专家": ("股票研究", "02杰哥扩展系统/01股票研究系统"),
        "杰哥股票顾问": ("股票研究", "02杰哥扩展系统/01股票研究系统"),
        "工作秘书": ("内容办公处理", "02杰哥扩展系统/03本职工作系统"),
        "视频助理": ("视频制作", "02杰哥扩展系统/02视频制作系统"),
        "系统管家": ("系统状态", "00杰哥系统总管"),
    }
    if target == "default":
        return {
            "路由": "澄清一次",
            "目标系统": "00公共组件/企业微信接入设置",
            "能力状态": "智能归因低信心",
            "智能归因": result,
            "fallback_msg": fallback,
        }
    if target in mapping:
        route_name, target_system = mapping[target]
        return {
            "路由": route_name,
            "目标系统": target_system,
            "能力状态": "智能归因已接入",
            "智能归因": result,
            "refined_query": refined,
        }
    return None


