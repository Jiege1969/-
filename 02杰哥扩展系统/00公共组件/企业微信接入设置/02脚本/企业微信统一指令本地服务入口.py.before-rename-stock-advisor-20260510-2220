def read_text_if_exists(path: Path, limit: int = 120000) -> str:
    try:
        if not path.exists():
            return ""
        return path.read_text(encoding="utf-8-sig", errors="ignore")[:limit]
    except OSError:
        return ""


def first_match(text: str, patterns: list[str]) -> str:
    for pattern in patterns:
        match = re.search(pattern, text, flags=re.IGNORECASE)
        if match:
            return " ".join(match.group(1).strip().split())
    return ""


def sentence(text: str) -> str:
    clean = str(text).strip()
    return clean if clean.endswith(("。", "！", "？", ".", "!", "?")) else f"{clean}。"


def load_progress_snapshot() -> dict[str, Any]:
    structured = load_json(LATEST_PROGRESS_JSON, {})
    progress_estimate = structured.get("进度估算", {}) if isinstance(structured, dict) else {}
    main_progress = progress_estimate.get("多功能智能体总体", {}) if isinstance(progress_estimate, dict) else {}
    time_estimate = structured.get("时间估算", {}) if isinstance(structured, dict) else {}
    progress = ""
    if isinstance(main_progress, dict) and main_progress.get("下限") is not None and main_progress.get("上限") is not None:
        progress = f"{main_progress.get('下限')}%-{main_progress.get('上限')}%"
    daily_remaining = str(time_estimate.get("到日常可用多功能智能体还需小时") or "").strip() if isinstance(time_estimate, dict) else ""
    stable_remaining = str(time_estimate.get("到稳定智能体中台还需小时") or "").strip() if isinstance(time_estimate, dict) else ""
    final_remaining = str(time_estimate.get("到多功能智能体终局还需小时") or "").strip() if isinstance(time_estimate, dict) else ""
    remaining_parts = []
    if daily_remaining:
        remaining_parts.append(f"日常可用 {daily_remaining}小时")
    if stable_remaining:
        remaining_parts.append(f"稳定中台 {stable_remaining}小时")
    if final_remaining:
        remaining_parts.append(f"终局 {final_remaining}小时")
    remaining = "；".join(remaining_parts)
    stage = str(structured.get("当前所在步骤") or "").strip() if isinstance(structured, dict) else ""

    progress_text = read_text_if_exists(LATEST_PROGRESS_JSON)
    panel_text = read_text_if_exists(CURRENT_PANEL_MD)
    combined = "\n".join([progress_text, panel_text])
    progress = progress or first_match(combined, [
        r"当前进度[：:\"]+\s*([0-9]{1,3}\s*%?\s*[-~至]\s*[0-9]{1,3}\s*%?)",
        r"全盘当前进度[：:\"]+\s*([0-9]{1,3}\s*%?\s*[-~至]\s*[0-9]{1,3}\s*%?)",
        r"全盘.*?进度[：:\"]+\s*([0-9]{1,3}\s*%?\s*[-~至]\s*[0-9]{1,3}\s*%?)",
    ])
    remaining = remaining or first_match(combined, [
        r"剩余(?:有效)?(?:工作)?(?:工时|时间)[：:\"]+\s*([0-9.]+\s*[-~至]\s*[0-9.]+\s*小时|[0-9.]+\s*小时)",
        r"全盘剩余(?:有效)?(?:工作)?(?:工时|时间)[：:\"]+\s*([0-9.]+\s*[-~至]\s*[0-9.]+\s*小时|[0-9.]+\s*小时)",
    ])
    stage = stage or first_match(combined, [
        r"当前状态[：:\"]+\s*([^\n\r\",，。]+)",
        r"结论[：:\"]+\s*([^\n\r\",，。]+)",
    ])
    resume_rule = load_json(ONE_CLICK_RESUME_RULE, {})
    resume_outputs = resume_rule.get("当前权威输出", {}) if isinstance(resume_rule, dict) else {}
    resume_md = str(resume_outputs.get("Markdown") or DEFAULT_ONE_CLICK_RESUME_MD)
    resume_json = str(resume_outputs.get("JSON") or DEFAULT_ONE_CLICK_RESUME_JSON)
    return {
        "progress": progress or "未读到最新进度口径",
        "remaining": remaining or "未读到剩余工时口径",
        "stage": stage or "按最新总管证据口径运行",
        "one_click_resume_markdown": resume_md,
        "one_click_resume_json": resume_json,
        "progress_file": str(LATEST_PROGRESS_JSON),
        "panel_file": str(CURRENT_PANEL_MD),
    }


