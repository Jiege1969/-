def is_feedback_intake_message(message: str) -> bool:
    text = "".join(str(message or "").strip().split())
    if not text:
        return False
    subject_terms = ("报告", "回复", "回答", "清单", "草案", "脚本", "分镜", "材料", "进度", "内容", "口径", "功能", "股票名称")
    feedback_terms = ("缺少", "少了", "太空泛", "太平", "不够", "没讲清", "应该可以", "应该有", "建议", "反馈", "改成", "添加", "补充", "不要")
    if "需要准备" in text or "需要哪些" in text:
        return False
    return any(subject in text for subject in subject_terms) and any(term in text for term in feedback_terms)


