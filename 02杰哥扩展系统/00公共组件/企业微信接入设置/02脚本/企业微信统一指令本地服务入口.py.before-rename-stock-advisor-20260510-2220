def is_video_question(message: str) -> bool:
    normalized = "".join(str(message).strip().lower().split())
    if not normalized:
        return False
    if is_help_message(message):
        return True
    if re.search(r"vf-\d{8}-\d{3}", normalized, flags=re.IGNORECASE):
        return True
