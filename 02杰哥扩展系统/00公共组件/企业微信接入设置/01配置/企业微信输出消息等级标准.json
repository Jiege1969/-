{
  "名称": "企业微信输出消息等级标准",
  "版本": "v1.0",
  "生成时间": "2026-05-09",
  "定位": "统一企业微信作为用户终端时的输出质量、长度、边界和可发送内容标准，避免把调试信息、桥接记录或半成品内容发给用户。",
  "总原则": [
    "企业微信是用户与系统交流的终端，不展示脚本阶段、桥接运行记录、success、real_send、n8n、券商/交易等调试字段。",
    "所有输出必须先判断消息等级，再决定是否完整输出、带水印输出、仅通知输出或阻断。",
    "系统状态、红线、技术日志可进入后台日志，不直接混入业务报告正文。",
    "任何真实发送仍受统一消息出口和灰度/白名单/人工确认规则约束。"
  ],
  "等级": [
    {
      "等级": "A",
      "名称": "标准格式化完整输出",
      "适用": [
        "股票三阶段报告",
        "股票单股研究报告",
        "股票盘前/盘后观察列表",
        "系统管家面向用户的明确状态摘要"
      ],
      "输出方式": "可直接输出完整可读内容；允许分段；标题、称呼、结尾声明必须符合对应机器人规范。",
      "必须包含": [
        "用户可读标题",
        "明确结论",
        "关键条件或依据",
        "风险边界或责任声明"
      ],
      "禁止包含": [
        "桥接运行记录",
        "阶段字段",
        "成功字段",
        "真实发送企业微信字段",
        "接券商/交易字段",
        "企业微信可读内容字样",
        "脚本路径或内部调试堆栈"
      ]
    },
    {
      "等级": "B",
      "名称": "带水印待复核输出",
      "适用": [
        "税收待复核草案",
        "政策依据摘要",
        "资料清单",
        "办公/内容处理草案"
      ],
      "输出方式": "可输出摘要和待复核内容，但必须带待复核水印和非正式声明。",
      "固定水印": "【待复核草案，不构成正式结论】",
      "必须包含": [
        "事项名称",
        "依据或材料来源提示",
        "缺口/待补字段",
        "人工复核提醒"
      ],
      "禁止包含": [
        "正式税务结论",
        "办理指令",
        "金额测算结论",
        "自动提交/自动申报暗示"
      ]
    },
    {
      "等级": "C",
      "名称": "只发通知不发完整内容",
      "适用": [
        "视频脚本草案",
        "视频分镜草案",
        "发布预检结果",
        "生成/渲染/发布门禁",
        "大文件或长文档草稿"
      ],
      "输出方式": "只发送简短通知、状态、任务ID和查看路径提示；不直接塞入完整长内容。",
      "必须包含": [
        "任务ID或标题",
        "当前状态",
        "是否blocked",
        "下一步需要人工复核的事项"
      ],
      "禁止包含": [
        "完整视频脚本长文",
        "素材未授权内容",
        "发布口令",
        "真实上传/发布成功暗示"
      ]
    },
    {
      "等级": "D",
      "名称": "阻断/需确认输出",
      "适用": [
        "触碰红线",
        "需重载19310或19302",
        "启用n8n",
        "真实发送企业微信",
        "接入外部账号或正式库"
      ],
      "输出方式": "只输出阻断原因和需总管确认项，不输出业务正文。",
      "必须包含": [
        "阻断原因",
        "需确认动作",
        "当前未执行声明"
      ]
    }
  ],
  "默认映射": {
    "股票三阶段报告": "A",
    "股票单股详细报告": "A",
    "税收待复核草案": "B",
    "税收资料清单": "B",
    "视频草案": "C",
    "视频真实渲染预检": "C",
    "视频发布预检": "C",
    "办公草稿": "B",
    "内容处理预演": "B",
    "红线或需确认事项": "D"
  },
  "安全边界": {
    "本标准不代表真实发送已开启": true,
    "本标准不启用n8n": true,
    "本标准不修改19310运行代码": true,
    "本标准不替代业务系统自身红线": true
  }
}
