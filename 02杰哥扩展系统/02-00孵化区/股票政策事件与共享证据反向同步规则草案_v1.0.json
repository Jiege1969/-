{
  "version": "1.0",
  "date": "2026-05-07",
  "rule_id": "STOCK_POLICY_EVIDENCE_REVERSE_SYNC_DRAFT_001",
  "name": "股票政策事件与共享证据反向同步规则草案",
  "asset_identity": "stock_policy_event_to_shared_policy_evidence_reverse_sync_shadow_rule_draft",
  "risk_level": "W1",
  "boundary": {
    "modify_stock_formal_config": false,
    "modify_l3_contract": false,
    "write_stock_formal_data": false,
    "write_tax_policy_database": false,
    "trade_advice": false,
    "external_send": false,
    "trigger_n8n": false
  },
  "sync_directions": [
    {
      "direction": "shared_policy_evidence_to_stock_research",
      "allowed": true,
      "risk_level": "W1_readonly",
      "note": "作为行业政策背景、风险提示、研究证据线索"
    },
    {
      "direction": "stock_research_to_shared_policy_evidence_candidate",
      "allowed": true,
      "risk_level": "W1_draft",
      "note": "只能生成候选记录，不写正式库"
    },
    {
      "direction": "stock_research_to_tax_policy_formal_database",
      "allowed": false,
      "note": "税收政策库必须由税务证据流程复核"
    },
    {
      "direction": "stock_research_to_stock_l3_formal_config",
      "allowed": false,
      "note": "不自动改变评分契约、权重或前台输出标准"
    }
  ],
  "candidate_fields": [
    "candidate_id",
    "source_system",
    "source_sample",
    "policy_evidence_id",
    "policy_title",
    "evidence_type",
    "stock_context",
    "allowed_target",
    "forbidden_target",
    "missing",
    "review_questions",
    "status"
  ],
  "example_candidate": {
    "candidate_id": "STOCK-TO-POLICY-CAND-001",
    "source_system": "stock_research_system",
    "source_sample": "共享政策证据只读调用样例_STOCK_002_软件行业税费政策背景_v1.0.md",
    "policy_evidence_id": "TAX-DOC-2011-100",
    "evidence_type": "policy_background",
    "stock_context": "软件行业税费政策背景，不判断具体公司是否享受",
    "allowed_target": ["shared_policy_evidence_candidate_pool", "stock_review_candidate", "tax_pending_verification_item"],
    "forbidden_target": ["stock_l3_formal_config", "trade_advice", "formal_tax_conclusion", "n8n_workflow"],
    "missing": ["公司收入结构", "财报披露", "实际享受情况", "材料条件", "地方口径"],
    "status": "draft"
  },
  "rules": [
    "反向同步候选只能进入影子候选，不得自动写正式库",
    "股票系统发现的政策影响必须降级为研究线索，不能升格为税务适用结论",
    "税收政策库只接收政策证据候选和待核验问题，不接收股票评分、涨跌判断、交易语义",
    "股票L3只接收人工复核后的结构化政策事件或行业风险，不接收税务适用结论",
    "改股票正式配置、正式脚本或正式数据目录必须暂停并按W2/W3规则确认"
  ],
  "review_questions": [
    "该政策是否确实与目标行业或公司业务相关？",
    "政策证据的有效状态是否已经官方复核？",
    "股票研究引用的是政策背景、政策事件，还是具体公司受益判断？",
    "是否有财报、公告、互动易、招股书等公司证据支撑？",
    "是否存在把税务适用条件误写为股票评分加分项的风险？",
    "该候选应进入共享证据候选池、税务待核验项，还是股票复盘候选？"
  ],
  "acceptance": {
    "no_formal_database_write": true,
    "no_l3_score_change": true,
    "no_business_confusion": true,
    "traceable_source": true,
    "candidate_status_only": ["draft", "pending_review"]
  }
}
