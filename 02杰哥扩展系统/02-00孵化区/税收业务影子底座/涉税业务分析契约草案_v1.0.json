  "confidence_states": [
    {
      "state": "draft",
      "meaning": "初步草案，证据或业务事实不完整",
      "allowed_output": "方向、依据候选、待补项"
    },
    {
      "state": "evidence_ready",
      "meaning": "证据链较完整，但未人工复核",
      "allowed_output": "待复核分析结论"
